---
import { Icon } from "astro-icon/components";
import localData from "../data/home.json";

const contactLinks = localData.socials.filter(
  (social) =>
    social.showInContact &&
    social.url &&
    social.url !== "#",
);
---

<section id="contact" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="contact-content mx-auto max-w-4xl opacity-0">
      <header class="mb-10 text-center md:mb-12">
        <h2
          class="mb-3 font-heading text-3xl font-bold text-maintext md:text-5xl"
        >
          Get in touch with me
        </h2>
        <p class="mx-auto max-w-xl font-body text-sm text-subtext md:text-base">
          Have a project in mind? Let's build something thoughtful together.
        </p>
      </header>

      <div class="contact-panel relative rounded-lg border border-accent/10 bg-accent/5 p-5 sm:p-8 md:p-10">
        <form
          id="contact-form"
          action="https://formspree.io/f/mqpkebbk"
          method="POST"
          class="relative z-10 grid gap-6 md:grid-cols-2"
          aria-label="Contact form"
        >
          <div
            class="contact-feedback contact-success md:col-span-2"
            role="status"
            aria-live="polite"
            data-fs-success
          >
            Thanks, your message is on its way. I'll get back to you soon.
          </div>

          <div
            class="contact-feedback contact-error md:col-span-2"
            role="alert"
            data-fs-error
          >
            Something went wrong. Please try again or email me directly.
          </div>

          <div class="contact-field">
            <label for="contact-name">Name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Your name"
              minlength="2"
              maxlength="100"
              required
              data-fs-field
            />
            <span class="contact-field-error" data-fs-error="name"></span>
          </div>

          <div class="contact-field">
            <label for="contact-email">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              maxlength="254"
              required
              data-fs-field
            />
            <span class="contact-field-error" data-fs-error="email"></span>
          </div>

          <div class="contact-field md:col-span-2">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              placeholder="Tell me a little about your project"
              minlength="10"
              maxlength="3000"
              required
              data-fs-field
            ></textarea>
            <span class="contact-field-error" data-fs-error="message"></span>
          </div>

          <div class="contact-honeypot" aria-hidden="true">
            <label for="contact-company">Leave this field empty</label>
            <input
              id="contact-company"
              name="_gotcha"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <input
            type="hidden"
            name="subject"
            value="New portfolio contact message"
          />

          <button
            type="submit"
            class="contact-submit md:col-span-2"
            data-fs-submit-btn
          >
            <span class="submit-default">Send message</span>
            <span class="submit-loading">
              <Icon name="mdi:loading" class="h-5 w-5" />
              Sending...
            </span>
          </button>
        </form>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
        {
          contactLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link group inline-flex items-center gap-2 text-sm text-subtext"
            >
              <Icon
                name={social.icon}
                class="h-5 w-5 text-accent transition-transform duration-300 group-hover:scale-110"
              />
              <span>{social.name}</span>
            </a>
          ))
        }
      </div>

      <footer class="mt-16 border-t border-white/5 pt-8 text-center md:mt-20">
        <p class="font-body text-sm text-subtext">
          {localData.name} © 2026
        </p>
      </footer>
    </div>
  </div>
</section>

<style>
  .contact-content {
    transform: translateY(24px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-content.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .contact-panel {
    isolation: isolate;
    box-shadow:
      0 28px 70px -42px color-mix(in srgb, var(--color-accent), transparent 20%),
      0 1px 0 color-mix(in srgb, var(--color-maintext), transparent 94%) inset;
  }

  .contact-panel::after {
    position: absolute;
    z-index: 0;
    right: 7%;
    bottom: -20px;
    left: 7%;
    height: 56px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent), transparent 35%);
    filter: blur(38px);
    opacity: 0;
    transform: translateY(14px) scaleX(0.55);
    content: "";
    pointer-events: none;
  }

  .contact-panel.underlight-visible::after {
    animation: contact-underlight 1.25s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  @keyframes contact-underlight {
    to {
      opacity: 0.7;
      transform: translateY(0) scaleX(1);
    }
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .contact-field label {
    color: var(--color-maintext);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .contact-field input,
  .contact-field textarea {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 82%);
    border-radius: 8px;
    outline: none;
    background: color-mix(in srgb, var(--color-background), black 28%);
    color: var(--color-maintext);
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .contact-field input {
    min-height: 3.25rem;
    padding: 0 1rem;
  }

  .contact-field textarea {
    min-height: 10rem;
    resize: vertical;
    padding: 0.9rem 1rem;
  }

  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: color-mix(in srgb, var(--color-subtext), transparent 28%);
  }

  .contact-field input:hover,
  .contact-field textarea:hover {
    border-color: color-mix(in srgb, var(--color-accent), transparent 55%);
    background: color-mix(in srgb, var(--color-background), black 20%);
  }

  .contact-field input:focus,
  .contact-field textarea:focus {
    border-color: color-mix(in srgb, var(--color-accent), transparent 15%);
    background: color-mix(in srgb, var(--color-background), black 16%);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent), transparent 82%);
  }

  .contact-field input[aria-invalid="true"],
  .contact-field textarea[aria-invalid="true"] {
    border-color: #ef4444;
    box-shadow: 0 0 0 3px color-mix(in srgb, #ef4444, transparent 84%);
  }

  [data-fs-error]:not([data-fs-active]),
  [data-fs-success]:not([data-fs-active]) {
    display: none;
  }

  .contact-feedback {
    border: 1px solid;
    border-radius: 8px;
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .contact-success {
    border-color: color-mix(in srgb, var(--color-accent), transparent 65%);
    background: color-mix(in srgb, var(--color-accent), transparent 90%);
    color: var(--color-maintext);
  }

  .contact-error {
    border-color: color-mix(in srgb, #ef4444, transparent 60%);
    background: color-mix(in srgb, #ef4444, transparent 90%);
    color: color-mix(in srgb, #ef4444, var(--color-maintext) 35%);
  }

  .contact-field-error {
    color: color-mix(in srgb, #ef4444, var(--color-maintext) 25%);
    font-family: var(--font-body);
    font-size: 0.75rem;
  }

  .contact-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  :global([data-theme$="-light"]) .contact-field input,
  :global([data-theme$="-light"]) .contact-field textarea {
    border-color: color-mix(in srgb, var(--color-accent), transparent 90%);
    background: color-mix(in srgb, var(--color-accent), transparent 95%);
  }

  :global([data-theme$="-light"]) .contact-field input:hover,
  :global([data-theme$="-light"]) .contact-field textarea:hover {
    border-color: color-mix(in srgb, var(--color-accent), transparent 60%);
    background: color-mix(in srgb, var(--color-accent), transparent 90%);
  }

  :global([data-theme$="-light"]) .contact-field input:focus,
  :global([data-theme$="-light"]) .contact-field textarea:focus {
    border-color: color-mix(in srgb, var(--color-accent), transparent 25%);
    background: color-mix(in srgb, var(--color-accent), transparent 90%);
  }

  .contact-submit {
    min-height: 3.25rem;
    border: 1px solid color-mix(in srgb, var(--color-accent), white 14%);
    border-radius: 8px;
    background: var(--color-accent);
    box-shadow: 0 12px 30px -18px var(--color-accent);
    color: var(--color-background);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    transition:
      filter 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .contact-submit:hover:not(:disabled) {
    box-shadow: 0 16px 34px -18px var(--color-accent);
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .contact-submit:disabled {
    cursor: wait;
    filter: saturate(0.75);
  }

  .submit-loading {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .contact-submit:disabled .submit-default {
    display: none;
  }

  .contact-submit:disabled .submit-loading {
    display: inline-flex;
  }

  .submit-loading :global(svg) {
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .contact-link {
    transition: color 0.25s ease;
  }

  .contact-link:hover {
    color: var(--color-maintext);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-content {
      transform: none;
      transition: none;
    }

    .contact-panel.underlight-visible::after {
      opacity: 0.7;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  import { initForm } from "@formspree/ajax";

  let formHandle: ReturnType<typeof initForm> | undefined;

  const setupContactForm = () => {
    formHandle?.destroy();
    formHandle = initForm({
      formElement: "#contact-form",
      formId: "mqpkebbk",
      useDefaultStyles: false,
      data: {
        source: "antonin-jech portfolio",
      },
    });
  };

  const revealContact = () => {
    const content = document.querySelector(".contact-content");
    const panel = document.querySelector(".contact-panel");

    if (!content || !panel) return;

    const contentObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;

        entry.target.classList.add("reveal");
        contentObserver.unobserve(entry.target);
      },
      { threshold: 0.1 },
    );

    const underlightObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;

        const isFullyVisible = entry.intersectionRatio >= 0.99;
        const viewportBottom = entry.rootBounds?.bottom ?? window.innerHeight;
        const isBelowViewport = entry.boundingClientRect.bottom > viewportBottom;

        if (isFullyVisible) {
          entry.target.classList.add("underlight-visible");
        } else if (isBelowViewport) {
          entry.target.classList.remove("underlight-visible");
        }
      },
      { threshold: [0, 0.99, 1] },
    );

    contentObserver.observe(content);
    underlightObserver.observe(panel);
  };

  setupContactForm();
  revealContact();
  document.addEventListener("astro:after-swap", () => {
    setupContactForm();
    revealContact();
  });
</script>
